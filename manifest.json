{
  "manifest_version": 3,
  "name": "PokeIdle Helper",
  "version": "0.5.0",
  "description": "Captura, reposição de bolas/poções, gerenciador de hunt e radar RMT (Ouro→Gema) para o pokeidle.io (só cliques no DOM).",
  "permissions": ["alarms"],
  "host_permissions": ["https://pokeidle.io/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://pokeidle.io/app*"],
      "js": ["fps.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://pokeidle.io/app*"],
      "js": ["types.js", "rmt.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
