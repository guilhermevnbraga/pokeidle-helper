WEB_USER=pokeidle
WEB_PASSWORD=troque-por-uma-senha-forte
# IP em que a interface web escuta. Deixe 127.0.0.1 para só local, ou ponha o IP do CT para acessar pela rede.
BIND_IP=127.0.0.1
# Perfis abertos em grade (Default preserva a 1ª conta). Ajuste se quiser menos contas.
POKEIDLE_PROFILES=Default,Conta2,Conta3,Conta4
# Resolução da tela virtual (1440x900 = 4 janelas de 720x450 em grade 2x2)
SCREEN_WIDTH=1440
SCREEN_HEIGHT=900
# Teto de RAM do container (com CT de 3 GB use 2600m; com CT de 4 GB pode usar 3400m)
MEM_LIMIT=2600m
