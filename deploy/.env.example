WEB_USER=pokeidle
WEB_PASSWORD=troque-por-uma-senha-forte
# IP em que a interface web escuta. Deixe 127.0.0.1 para só local, ou ponha o IP do CT para acessar pela rede.
BIND_IP=127.0.0.1
# Perfis abertos no mesmo Chromium (Default preserva a 1ª conta). Ajuste se quiser menos contas.
POKEIDLE_PROFILES=Default,Conta2,Conta3,Conta4
# 1 = minimiza as contas automaticamente após o boot (GPU/compositor = 0%); clique na barra inferior para abrir
POKEIDLE_AUTO_MINIMIZE=1
# Teto de RAM do container (com CT de 3 GB use 2800m; com CT de 4 GB pode usar 3500m)
MEM_LIMIT=2800m
